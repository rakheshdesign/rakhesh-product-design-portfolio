{
 "cleanUrls": true,
 "trailingSlash": false,
 "redirects": [
  {
   "source": "/manage-credit-limit",
   "destination": "/work/manage-credit-limit",
   "permanent": true
  }
 ],
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "X-Frame-Options",
     "value": "SAMEORIGIN"
    }
   ]
  },
  {
   "source": "/vendor/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  }
 ]
}